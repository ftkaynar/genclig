# Supabase proje ayarlarından alınır (Project Settings > API).
# Bu iki değer public'tir, client bundle'a girer. Service role key BURAYA YAZILMAZ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push (D30). Anahtar çifti `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# ile üretiliyor. PRIVATE anahtar repoya GİRMEZ; yalnızca .env.local ve
# Vercel ortam değişkenlerinde durur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ornek@alan.com

# Push gönderimi sunucu tarafında service_role ile abonelikleri okuyor.
# Bu anahtar da repoya GİRMEZ.
SUPABASE_SERVICE_ROLE_KEY=
